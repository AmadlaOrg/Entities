{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "id": "urn:hery:github.com:AmadlaOrg:Secret",
  "title": "Secret Entity",
  "description": "Defines secret references. Used by doorman to resolve secrets from backends (vault, aws, keepassxc, keycloak).",
  "type": "object",
  "properties": {
    "backend": {
      "type": "string",
      "description": "Doorman plugin name (e.g., vault, aws, keepassxc, keycloak, env)."
    },
    "path": {
      "type": "string",
      "description": "Secret path within the backend."
    },
    "key": {
      "type": "string",
      "description": "Specific key within the secret path."
    },
    "env_var": {
      "type": "string",
      "description": "Environment variable name to expose the secret as."
    },
    "file": {
      "type": "string",
      "description": "File path to write the secret to."
    },
    "file_mode": { "type": ["string", "integer"], "default": "0600" },
    "file_owner": { "type": "string", "description": "File owner (user:group)." },
    "rotate": {
      "type": "object",
      "properties": {
        "interval": { "type": "string", "description": "Rotation interval (e.g., 24h, 7d)." },
        "on_change": { "type": "string", "description": "Command to execute after rotation." }
      }
    },
    "fallback": { "type": "string", "description": "Fallback backend." }
  },
  "required": ["backend", "path"]
}
