{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "id": "urn:hery:github.com:AmadlaOrg:Infrastructure:Cloud:ObjectStorage",
  "title": "Infrastructure Cloud Object Storage Entity",
  "description": "Common properties shared by all object storage providers.",
  "type": "object",
  "properties": {
    "bucket_name": {
      "type": "string",
      "description": "Name of the storage bucket."
    },
    "acl": {
      "type": "string",
      "enum": ["private", "public-read", "public-read-write"],
      "description": "Access control list for the bucket."
    },
    "versioning": {
      "type": "boolean",
      "description": "Enable object versioning."
    },
    "lifecycle_rules": {
      "type": "array",
      "description": "Lifecycle management rules for objects.",
      "items": {
        "type": "object",
        "properties": {
          "prefix": { "type": "string" },
          "expiration_days": { "type": "integer" },
          "transition": {
            "type": "object",
            "properties": {
              "days": { "type": "integer" },
              "storage_class": { "type": "string" }
            }
          }
        }
      }
    }
  }
}
