{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "id": "urn:hery:github.com:AmadlaOrg:Infrastructure:Cloud:Compute:Azure:VM",
  "title": "Azure Virtual Machine Entity",
  "description": "Azure VM-specific compute instance properties.",
  "type": "object",
  "properties": {
    "vm_size": {
      "type": "string",
      "description": "Azure VM size (e.g., Standard_B2s, Standard_D4s_v3)."
    },
    "resource_group": {
      "type": "string",
      "description": "Azure resource group name."
    },
    "vnet_name": {
      "type": "string",
      "description": "Virtual network name."
    },
    "subnet_name": {
      "type": "string",
      "description": "Subnet name within the virtual network."
    },
    "nsg_name": {
      "type": "string",
      "description": "Network security group name."
    },
    "os_disk": {
      "type": "object",
      "properties": {
        "caching": {
          "type": "string",
          "description": "OS disk caching mode (e.g., ReadWrite, ReadOnly, None)."
        },
        "storage_account_type": {
          "type": "string",
          "enum": ["Standard_LRS", "Premium_LRS", "StandardSSD_LRS"],
          "description": "Managed disk storage account type."
        }
      },
      "description": "OS disk configuration."
    },
    "source_image_reference": {
      "type": "object",
      "properties": {
        "publisher": { "type": "string", "description": "Image publisher (e.g., Canonical)." },
        "offer": { "type": "string", "description": "Image offer (e.g., 0001-com-ubuntu-server-jammy)." },
        "sku": { "type": "string", "description": "Image SKU (e.g., 22_04-lts)." },
        "version": { "type": "string", "description": "Image version (e.g., latest)." }
      },
      "description": "Source image reference for the VM."
    },
    "admin_username": {
      "type": "string",
      "description": "Administrator username for the VM."
    },
    "admin_ssh_key": {
      "type": "string",
      "description": "SSH public key for admin authentication."
    }
  },
  "required": ["vm_size", "resource_group"]
}
