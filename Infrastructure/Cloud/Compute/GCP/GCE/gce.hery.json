{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "id": "urn:hery:github.com:AmadlaOrg:Infrastructure:Cloud:Compute:GCP:GCE",
  "title": "GCP Compute Engine Instance Entity",
  "description": "Google Cloud Compute Engine-specific instance properties.",
  "type": "object",
  "properties": {
    "machine_type": {
      "type": "string",
      "description": "GCE machine type (e.g., e2-medium, n2-standard-4)."
    },
    "zone": {
      "type": "string",
      "description": "GCP zone (e.g., us-central1-a)."
    },
    "network": {
      "type": "string",
      "description": "VPC network name or self link."
    },
    "subnetwork": {
      "type": "string",
      "description": "Subnetwork name or self link."
    },
    "service_account": {
      "type": "object",
      "properties": {
        "email": {
          "type": "string",
          "description": "Service account email address."
        },
        "scopes": {
          "type": "array",
          "items": { "type": "string" },
          "description": "OAuth2 scopes for the service account."
        }
      },
      "description": "Service account configuration."
    },
    "preemptible": {
      "type": "boolean",
      "description": "Whether to use a preemptible instance."
    },
    "boot_disk": {
      "type": "object",
      "properties": {
        "image": {
          "type": "string",
          "description": "Boot disk image (e.g., debian-cloud/debian-12)."
        },
        "size_gb": {
          "type": "integer",
          "description": "Boot disk size in GB."
        },
        "type": {
          "type": "string",
          "enum": ["pd-standard", "pd-ssd", "pd-balanced"],
          "description": "Persistent disk type."
        }
      },
      "description": "Boot disk configuration."
    },
    "labels": {
      "type": "object",
      "additionalProperties": { "type": "string" },
      "description": "GCP labels applied to the instance."
    }
  },
  "required": ["machine_type", "zone"]
}
