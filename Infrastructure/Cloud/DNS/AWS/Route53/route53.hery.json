{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "id": "urn:hery:github.com:AmadlaOrg:Infrastructure:Cloud:DNS:AWS:Route53",
  "title": "AWS Route 53 Entity",
  "description": "AWS Route 53-specific DNS properties.",
  "type": "object",
  "properties": {
    "hosted_zone_id": {
      "type": "string",
      "description": "Route 53 hosted zone ID."
    },
    "routing_policy": {
      "type": "string",
      "enum": ["simple", "weighted", "latency", "failover", "geolocation", "multivalue"],
      "description": "DNS routing policy."
    },
    "health_checks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "protocol": {
            "type": "string",
            "enum": ["HTTP", "HTTPS", "TCP"],
            "description": "Health check protocol."
          },
          "fqdn": { "type": "string", "description": "Fully qualified domain name to check." },
          "port": { "type": "integer", "description": "Port to check." },
          "path": { "type": "string", "description": "HTTP path for health check." },
          "interval": { "type": "integer", "description": "Health check interval in seconds." },
          "failure_threshold": { "type": "integer", "description": "Number of failures before unhealthy." }
        },
        "required": ["protocol"]
      },
      "description": "Route 53 health check configurations."
    },
    "alias_records": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": { "type": "string", "description": "Record name." },
          "target_hosted_zone_id": { "type": "string", "description": "Target resource hosted zone ID." },
          "target_dns_name": { "type": "string", "description": "Target resource DNS name." },
          "evaluate_target_health": { "type": "boolean", "description": "Whether to evaluate target health." }
        },
        "required": ["name", "target_dns_name"]
      },
      "description": "Route 53 alias record definitions."
    }
  },
  "required": ["hosted_zone_id"]
}
