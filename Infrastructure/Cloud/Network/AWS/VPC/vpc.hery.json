{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "id": "urn:hery:github.com:AmadlaOrg:Infrastructure:Cloud:Network:AWS:VPC",
  "title": "AWS VPC Entity",
  "description": "AWS VPC-specific network properties.",
  "type": "object",
  "properties": {
    "vpc_cidr": {
      "type": "string",
      "description": "VPC CIDR block (e.g., 10.0.0.0/16)."
    },
    "enable_dns_hostnames": {
      "type": "boolean",
      "description": "Whether to enable DNS hostnames in the VPC."
    },
    "enable_dns_support": {
      "type": "boolean",
      "description": "Whether to enable DNS support in the VPC."
    },
    "internet_gateway": {
      "type": "boolean",
      "description": "Whether to attach an internet gateway."
    },
    "nat_gateway": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean", "description": "Whether to create a NAT gateway." },
        "subnet": { "type": "string", "description": "Subnet ID for the NAT gateway." }
      },
      "description": "NAT gateway configuration."
    },
    "route_tables": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": { "type": "string", "description": "Route table name." },
          "routes": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "cidr": { "type": "string", "description": "Destination CIDR block." },
                "target": { "type": "string", "description": "Route target (e.g., igw-xxx, nat-xxx)." }
              },
              "required": ["cidr", "target"]
            }
          }
        },
        "required": ["name"]
      },
      "description": "Route table definitions."
    },
    "security_groups": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": { "type": "string", "description": "Security group name." },
          "description": { "type": "string", "description": "Security group description." },
          "ingress": {
            "type": "array",
            "items": { "type": "object" },
            "description": "Inbound rules."
          },
          "egress": {
            "type": "array",
            "items": { "type": "object" },
            "description": "Outbound rules."
          }
        },
        "required": ["name"]
      },
      "description": "Security group definitions."
    },
    "flow_logs": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean", "description": "Whether to enable VPC flow logs." },
        "destination": { "type": "string", "description": "Flow log destination (e.g., S3 bucket ARN, CloudWatch log group)." }
      },
      "description": "VPC flow log configuration."
    }
  },
  "required": ["vpc_cidr"]
}
