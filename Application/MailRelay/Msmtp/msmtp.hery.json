{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "id": "urn:hery:github.com:AmadlaOrg:Application:MailRelay:Msmtp",
  "title": "Application MailRelay Msmtp Entity",
  "description": "msmtp-specific configuration. Extends Application/MailRelay with msmtp-specific settings.",
  "type": "object",
  "properties": {
    "account": {
      "type": "string",
      "description": "Account name for this configuration."
    },
    "host": {
      "type": "string",
      "description": "SMTP server hostname."
    },
    "port": {
      "type": "integer",
      "description": "SMTP server port."
    },
    "tls": {
      "type": "boolean",
      "description": "Whether to use TLS."
    },
    "tls_starttls": {
      "type": "boolean",
      "description": "Whether to use STARTTLS instead of direct TLS."
    },
    "auth": {
      "type": "string",
      "description": "Authentication method.",
      "enum": ["plain", "login", "cram-md5", "on", "off"]
    },
    "log": {
      "type": "string",
      "description": "Log file path or 'syslog' for syslog logging."
    }
  }
}
