{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "id": "urn:hery:github.com:AmadlaOrg:Application:IdentityProvider:Keycloak",
  "title": "Application Identity Provider Keycloak Entity",
  "description": "Keycloak-specific configuration. Extends Application/IdentityProvider with Keycloak-specific settings.",
  "type": "object",
  "properties": {
    "hostname": {
      "type": "string",
      "description": "Public hostname for Keycloak."
    },
    "database": {
      "type": "object",
      "description": "Database configuration.",
      "properties": {
        "vendor": {
          "type": "string",
          "enum": ["postgres", "mysql", "mariadb", "mssql", "h2"],
          "description": "Database vendor."
        },
        "url": { "type": "string", "description": "JDBC connection URL." },
        "username": { "type": "string", "description": "Database username." },
        "password_secret": { "type": "string", "description": "Doorman secret reference for database password." }
      }
    },
    "realms": {
      "type": "array",
      "description": "Realm definitions.",
      "items": {
        "type": "object",
        "properties": {
          "name": { "type": "string", "description": "Realm name." },
          "display_name": { "type": "string", "description": "Realm display name." },
          "enabled": { "type": "boolean", "description": "Whether the realm is enabled." },
          "sso_session_idle_timeout": { "type": "string", "description": "SSO session idle timeout (e.g., '30m')." },
          "sso_session_max_lifespan": { "type": "string", "description": "SSO session max lifespan (e.g., '10h')." }
        }
      }
    },
    "smtp": {
      "type": "object",
      "description": "SMTP email configuration.",
      "properties": {
        "host": { "type": "string", "description": "SMTP host." },
        "port": { "type": "integer", "description": "SMTP port." },
        "from": { "type": "string", "description": "From email address." },
        "user": { "type": "string", "description": "SMTP username." },
        "password_secret": { "type": "string", "description": "Doorman secret reference for SMTP password." },
        "starttls": { "type": "boolean", "description": "Whether to use STARTTLS." }
      }
    },
    "proxy_mode": {
      "type": "string",
      "enum": ["edge", "reencrypt", "passthrough", "none"],
      "description": "Reverse proxy mode."
    },
    "features": {
      "type": "array",
      "description": "Enabled Keycloak features (e.g., docker, scripts, token-exchange).",
      "items": { "type": "string" }
    },
    "metrics_enabled": {
      "type": "boolean",
      "description": "Whether Prometheus metrics endpoint is enabled."
    }
  }
}
