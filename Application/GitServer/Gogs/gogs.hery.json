{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "id": "urn:hery:github.com:AmadlaOrg:Application:GitServer:Gogs",
  "title": "Application GitServer Gogs Entity",
  "description": "Gogs-specific configuration. Extends Application/GitServer with Gogs settings.",
  "type": "object",
  "properties": {
    "app_name": {
      "type": "string",
      "description": "Application display name."
    },
    "run_mode": {
      "type": "string",
      "enum": ["dev", "prod"],
      "description": "Run mode (development or production)."
    },
    "database": {
      "type": "object",
      "description": "Database configuration.",
      "properties": {
        "type": {
          "type": "string",
          "enum": ["sqlite3", "mysql", "postgres"],
          "description": "Database type."
        },
        "host": { "type": "string", "description": "Database host." },
        "name": { "type": "string", "description": "Database name." },
        "user": { "type": "string", "description": "Database user." },
        "password_secret": { "type": "string", "description": "Doorman secret reference for database password." }
      }
    },
    "repository_root": {
      "type": "string",
      "description": "Root directory for Git repositories."
    },
    "disable_registration": {
      "type": "boolean",
      "description": "Whether to disable user self-registration."
    },
    "require_sign_in_view": {
      "type": "boolean",
      "description": "Whether to require sign-in to view content."
    },
    "mailer": {
      "type": "object",
      "description": "Email notification configuration.",
      "properties": {
        "enabled": { "type": "boolean", "description": "Whether the mailer is enabled." },
        "host": { "type": "string", "description": "SMTP server host." },
        "from": { "type": "string", "description": "Sender email address." },
        "user": { "type": "string", "description": "SMTP authentication user." },
        "password_secret": { "type": "string", "description": "Doorman secret reference for SMTP password." }
      }
    }
  }
}
